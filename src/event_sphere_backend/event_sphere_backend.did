type Error = variant {
  NotFound : record { msg : text };
  AlreadyExists : record { msg : text };
  CustomError : text;
};
type Event = record {
  id : nat64;
  name : text;
  end_date : text;
  start_date : text;
  timestamp : nat64;
  attendees : vec nat64;
  details : text;
  location : text;
};
type EventPayload = record {
  name : text;
  end_date : text;
  start_date : text;
  details : text;
  location : text;
};
type Result = variant { Ok; Err : Error };
type Result_1 = variant { Ok : Event; Err : Error };
type Result_2 = variant { Ok : Ticket; Err : Error };
type Result_3 = variant { Ok : vec nat64; Err : Error };
type Ticket = record {
  attendee : text;
  ticket_price : nat64;
  ticket_id : nat64;
  ticket_type : text;
  event_id : nat64;
};
type TicketPayload = record {
  attendee : text;
  ticket_price : nat64;
  ticket_type : text;
  event_id : nat64;
};
service : {
  add_attendees : (nat64, vec nat64) -> (Result);
  add_event : (EventPayload) -> (opt Event);
  add_ticket : (TicketPayload) -> (opt Ticket);
  delete_event : (nat64) -> (Result_1);
  delete_ticket : (nat64) -> (Result_2);
  get_attendees : (nat64) -> (Result_3) query;
  get_event : (nat64) -> (Result_1) query;
  get_event_by_name : (text) -> (opt Event) query;
  get_events : () -> (vec Event) query;
  get_past_events : () -> (vec Event) query;
  get_tickets : (nat64) -> (vec Ticket) query;
  get_upcoming_events : () -> (vec Event) query;
  update_event : (nat64, EventPayload) -> (Result_1);
}
